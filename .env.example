# Copy to .env.local on the server; never commit the populated file.
FORUM_FORMS_ENABLED=true
# Recommended for deployment: a private absolute directory on persistent storage.
# Back up this directory together with its .campus-identity-key file.
# FORUM_DATA_DIR=/srv/astroconnect-2026/private-data
# Exact public HTTPS origin without a trailing slash.
# FORUM_PUBLIC_ORIGIN=https://your-conference-domain.example
